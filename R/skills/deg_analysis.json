{
  "name": "deg_analysis",
  "display_name": "差异表达分析流程",
  "description": "一键完成bulk RNA-seq差异表达分析：Log2归一化 → DESeq2差异基因筛选 → 火山图可视化。适用于两组比较的实验设计。",
  "category": "pipeline",
  "version": "1.0.0",
  "author": "seqTools",
  "omics": ["bulk_rna"],
  "tags": ["DEG", "volcano", "RNA-seq", "差异分析"],
  "steps": [
    {
      "id": "normalize_data",
      "tool": "normalize",
      "params": {"method": "log2"},
      "description": "Log2归一化表达矩阵"
    },
    {
      "id": "find_degs",
      "tool": "deg",
      "params": {"method": "DESeq2", "logFC_threshold": 1, "padj_threshold": 0.05, "filter": true},
      "description": "DESeq2差异基因筛选（|logFC|>1, padj<0.05）"
    },
    {
      "id": "volcano_plot",
      "tool": "volcano",
      "params": {},
      "description": "火山图可视化差异基因"
    }
  ]
}
