# R/tools/_example_template.R
# 新工具模板。复制此文件，修改 TOOL_NAME 和 TOOL_RUN 即可。
# 保存到 R/tools/ 后，工具自动热加载（无需重启）。
# 命名规则: R/tools/sc_<功能>_tool.R（单细胞） 或 R/tools/<功能>_tool.R（通用）

TOOL_NAME <- "example_tool"            # 唯一标识，AI 调用的名字
TOOL_CATEGORY <- "数据分析"            # 分类: 数据导入/数据预处理/数据分析/数据绘图
TOOL_DISPLAY_NAME <- "示例工具"        # UI 显示名
TOOL_OMICS <- "single_cell"           # single_cell / bulk_rna / NULL(通用)
TOOL_ORDER <- 99                      # 排序，越大越靠后

# 参数定义。AI 会看到这些作为 function 的 parameters
TOOL_SCHEMA <- list(
  genes = list(
    type    = "text",                 # text / number / integer / select / boolean / file
    required = TRUE,                   # 必填
    description = "基因名，英文逗号分隔。例: Slc3a2,Slc7a5（大小写自动纠正）"
  ),
  group_by = list(
    type    = "select",
    choices = NULL,                    # NULL = 动态加载（从 Seurat meta.data 读分类列）
    required = FALSE,
    description = "分组列。下拉框第一项=所有细胞一组。可选: seurat_clusters, cell_type"
  ),
  method = list(
    type    = "select",
    choices = c("pearson", "spearman"), # 静态选项
    default = "pearson",
    description = "相关性计算方法"
  ),
  top_n = list(
    type    = "integer",
    default = 10,
    min     = 1,
    max     = 100,
    description = "返回前 N 个结果"
  ),
  threshold = list(
    type    = "number",
    default = 0.5,
    min     = 0,
    max     = 1,
    description = "阈值。留空使用默认"
  ),
  flip = list(
    type    = "boolean",
    default = TRUE,
    description = "是否翻转坐标轴"
  ),
  input_file = list(
    type    = "file",
    required = TRUE,
    description = "输入文件（CSV或GMT格式）"
  )
)

# 核心执行函数。inputs 是用户/AI 传入的参数，project 是 R6 项目对象
TOOL_RUN <- function(inputs, project) {
  # 1. 加载数据
  key <- sc_find_seurat_key(project, NULL)
  seurat_obj <- sc_load_from_disk(project, key)

  # 2. 参数校验
  gene_vec <- trimws(strsplit(inputs$genes, ",")[[1]])
  gene_vec <- gene_vec[nzchar(gene_vec)]
  if (length(gene_vec) == 0) stop("未提供有效的基因名")

  res <- sc_match_genes(gene_vec, seurat_obj)
  if (!is.null(res$msg)) message(res$msg)
  gene_vec <- res$genes

  # 3. 调用底层函数（Seurat / seqTools / 自定义）
  # result <- seqTools::some_function(seurat_obj, genes = gene_vec, ...)

  # 4. 返回结果
  list(
    data = list(plot = NULL, table = NULL),  # 绘图对象或数据框
    messages = "示例工具完成",               # AI 和 UI 看到的提示
    method_info = record_method(TOOL_NAME, TOOL_DISPLAY_NAME,
      "底层函数名", "底层包名", inputs)       # 方法记录
  )
}

# 输出定义。plot/table = function 表示需要后处理，NULL = 无此输出
TOOL_OUTPUTS <- list(
  plot  = function(result) { if (inherits(result, "ggplot")) result else result$data$plot },
  table = function(result) { result$data$table }
)
